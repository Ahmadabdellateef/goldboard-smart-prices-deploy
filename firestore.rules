rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /goldboard/main {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.email == 'ahmadabdullateef03@gmail.com'
          || request.auth.token.email == 'kheedmah1@gmail.com');
    }
  }
}
